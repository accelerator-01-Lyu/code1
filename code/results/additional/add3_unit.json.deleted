  "figures": [
    {
      "file": "add3_gmm_gap_vs_ratio.png",
      "caption": "Fig. Paired gap (ACC@10%) vs class-overlap ratio. Columns = ambient dimension d, rows = sample size n; purple = c=2, pink = c=3; shaded band = 95% paired CI over 20 seeds; dashed line = zero gap.",

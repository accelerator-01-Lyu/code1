{
  "exp_id": 3,
  "title": "Synthetic GMM control: gap~overlap/d/n",
  "evidence_label": "supportive",
  "status": "complete",
  "motivation": "The main paired contrast (P2_Full vs P2_NoExploration) is confounded across real benchmarks by dataset geometry, dimensionality and overlap. This unit isolates the exploration reward $\\rho h_i$ in a fully controlled Gaussian mixture, varying class overlap (ratio = mean center distance / within-class std), ambient dimension $d$, sample size $n$, and number of classes $c$.",
  "hypothesis": "The exploration benefit (gap = ACC@10% of P2_Full minus P2_NoExploration) is positive and grows as overlap increases (smaller ratio), as ambient dimension grows, and is larger for smaller $n$.",
  "design": "2x4x4x5 factorial: c in {2,3}; d in {2,5,10,20}; n in {200,500,1000,2000}; ratio in {0.5,1,1.5,2,3}. Within-class covariance $I_d$; c centers on a regular simplex with pairwise distance = ratio (trailing dimensions are nuisance noise). Semi-supervised FCM backend reused from the main driver; P2_Full vs P2_NoExploration, 20 seeds, |L0|=max(c, 0.02N), checkpoint 10% labeled. ACC after Hungarian matching; paired by seed.",
  "protocol": {
    "datasets": [
      "synthetic_GMM"
    ],
    "methods": [
      "P2_Full",
      "P2_NoExploration"
    ],
    "n_seeds": 20,
    "budgets": [
      0.1
    ],
    "factors": {
      "c": [
        2,
        3
      ],
      "d": [
        2,
        5,
        10,
        20
      ],
      "n": [
        200,
        500,
        1000,
        2000
      ],
      "ratio": [
        0.5,
        1.0,
        1.5,
        2.0,
        3.0
      ]
    },
    "checkpoint": 0.1
  },
